<UserControl x:Class="QuickLook.Plugin.GitViewer.GitPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QuickLook.Plugin.GitViewer"
             Background="{DynamicResource PanelBackground}"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />

        <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New, monospace</FontFamily>

        <Style x:Key="ChipBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ChipBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChipBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="0,0,6,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ChipTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ChipText}" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="RefChipBorderStyle" TargetType="Border" BasedOn="{StaticResource ChipBorderStyle}">
            <Setter Property="Background" Value="{DynamicResource RefChipBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource RefChipBorder}" />
            <Setter Property="Margin" Value="0,1,4,1" />
            <Setter Property="Padding" Value="5,0" />
        </Style>

        <Style x:Key="HashTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="Foreground" Value="{DynamicResource HashText}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="10,10,10,4" />
        </Style>

        <Style x:Key="EmptyTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
            <Setter Property="Margin" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 行容器：去掉焦点虚线框，悬停与选中颜色跟随主题。 -->
        <Style x:Key="RowItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnRowRightButtonDown" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowSelected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource RowItemStyle}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling" />
        </Style>

        <!-- TabControl 自带的外观写死了浅灰色，不换掉的话深色主题下会很突兀。 -->
        <Style x:Key="FlatTabItemStyle" TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" BorderThickness="0,0,0,2"
                                BorderBrush="Transparent" Padding="14,7">
                            <ContentPresenter x:Name="Header" ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.Foreground="{DynamicResource SecondaryText}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Header" Property="TextBlock.Foreground"
                                        Value="{DynamicResource PrimaryText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource FlatTabItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="{DynamicResource Separator}" BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True" Margin="8,0,0,0" />
                            </Border>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ContextMenu 不在可视树里，不会继承 DataContext，
             必须手动指向它所属元素的 DataContext。 -->
        <Style x:Key="OwnerContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="DataContext"
                    Value="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" />
        </Style>

        <!-- 提交行：哈希、提交说明及 ref 小标签、作者、相对时间。 -->
        <DataTemplate x:Key="CommitTemplate">
            <Grid Margin="10,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding ShortHash}" Style="{StaticResource HashTextStyle}"
                           Margin="0,0,10,0" ToolTip="{Binding Hash}" />

                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Subject}" Foreground="{DynamicResource PrimaryText}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Subject}" />
                    <ItemsControl ItemsSource="{Binding DecorationList}" Margin="0,2,0,0"
                                  Visibility="{Binding HasDecorations, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RefChipBorderStyle}">
                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource RefChipText}"
                                               FontSize="11" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding AuthorName}" Foreground="{DynamicResource SecondaryText}"
                           Margin="12,0,12,0" VerticalAlignment="Center" MaxWidth="140"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding AuthorTooltip}" />

                <TextBlock Grid.Column="3" Text="{Binding RelativeTime}" Foreground="{DynamicResource MutedText}"
                           VerticalAlignment="Center" MinWidth="88" TextAlignment="Right"
                           ToolTip="{Binding AbsoluteTime}" />
            </Grid>
        </DataTemplate>

        <!-- 分支行：名称、跟踪状态、最新提交哈希、说明、相对时间。 -->
        <DataTemplate x:Key="BranchTemplate">
            <Grid Margin="10,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x25CF;" Foreground="{DynamicResource Accent}" Margin="0,0,5,0"
                                   VerticalAlignment="Center" FontSize="10"
                                   Visibility="{Binding IsHead, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource PrimaryText}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Track}" Foreground="{DynamicResource Accent}" FontSize="11"
                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding HasTrack, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Subject}" Foreground="{DynamicResource MutedText}" FontSize="11"
                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subject}" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding ObjectName}" Style="{StaticResource HashTextStyle}"
                           Margin="12,0,12,0" FontSize="11" />

                <TextBlock Grid.Column="2" Text="{Binding RelativeTime}" Foreground="{DynamicResource MutedText}"
                           VerticalAlignment="Center" MinWidth="88" TextAlignment="Right"
                           ToolTip="{Binding AbsoluteTime}" />
            </Grid>
        </DataTemplate>

        <!-- 标签行：名称、所指对象哈希、说明、相对时间。 -->
        <DataTemplate x:Key="TagTemplate">
            <Grid Margin="10,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource PrimaryText}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subject}" Foreground="{DynamicResource MutedText}" FontSize="11"
                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subject}" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding ObjectName}" Style="{StaticResource HashTextStyle}"
                           Margin="12,0,12,0" FontSize="11" />

                <TextBlock Grid.Column="2" Text="{Binding RelativeTime}" Foreground="{DynamicResource MutedText}"
                           VerticalAlignment="Center" MinWidth="88" TextAlignment="Right"
                           ToolTip="{Binding AbsoluteTime}" />
            </Grid>
        </DataTemplate>

        <!-- 远程行：名称与 URL。 -->
        <DataTemplate x:Key="RemoteTemplate">
            <StackPanel Margin="10,6">
                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource PrimaryText}" />
                <TextBlock Text="{Binding Url}" Foreground="{DynamicResource SecondaryText}" FontSize="11"
                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Url}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部概览区 -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackground}"
                BorderBrush="{DynamicResource Separator}" BorderThickness="0,0,0,1" Padding="12,10,12,6">
            <StackPanel>
                <TextBlock Text="{Binding RepositoryName}" Foreground="{DynamicResource PrimaryText}"
                           FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding RepositoryPath}" Foreground="{DynamicResource MutedText}"
                           FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding RepositoryPath}" />

                <WrapPanel Margin="0,8,0,0">
                    <Border Style="{StaticResource ChipBorderStyle}">
                        <TextBlock Text="{Binding BranchLabel}" Style="{StaticResource ChipTextStyle}" />
                    </Border>

                    <Border Style="{StaticResource ChipBorderStyle}"
                            Visibility="{Binding HasShortHash, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ShortHash}" Style="{StaticResource HashTextStyle}" FontSize="11" />
                    </Border>

                    <Border Style="{StaticResource ChipBorderStyle}"
                            Visibility="{Binding HasSync, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding SyncText}" Style="{StaticResource ChipTextStyle}"
                                   ToolTip="{Binding UpstreamText}" />
                    </Border>

                    <Border Style="{StaticResource ChipBorderStyle}"
                            Visibility="{Binding HasStash, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding StashText}" Style="{StaticResource ChipTextStyle}" />
                    </Border>

                    <Border Style="{StaticResource ChipBorderStyle}"
                            Visibility="{Binding HasDescribe, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Describe}" Style="{StaticResource ChipTextStyle}" />
                    </Border>

                    <Border Style="{StaticResource ChipBorderStyle}"
                            Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding BadgeText}" Foreground="{DynamicResource ErrorText}" FontSize="11" />
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 错误态会整个取代页签区。 -->
        <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorText}"
                   Margin="24" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"
                   TextAlignment="Center"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

        <TabControl Grid.Row="1" Style="{StaticResource FlatTabControlStyle}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
            <TabItem Header="{Binding CommitsHeader}">
                <Grid>
                    <ListBox ItemsSource="{Binding Commits}" ItemTemplate="{StaticResource CommitTemplate}"
                             Style="{StaticResource RowListStyle}"
                             Visibility="{Binding HasCommits, Converter={StaticResource BoolToVis}}">
                        <ListBox.ContextMenu>
                            <ContextMenu Style="{StaticResource OwnerContextMenuStyle}">
                                <MenuItem Header="{Binding CopyHashText}" Click="OnCopyCommitHash" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                    <TextBlock Text="{Binding EmptyCommitsText}" Style="{StaticResource EmptyTextStyle}"
                               Visibility="{Binding HasCommits, Converter={StaticResource BoolToVis},
                                            ConverterParameter=invert}" />
                </Grid>
            </TabItem>

            <TabItem Header="{Binding BranchesHeader}">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasAnyBranch, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding LocalBranchesHeader}" Style="{StaticResource SectionHeaderStyle}"
                                       Visibility="{Binding HasLocalBranches, Converter={StaticResource BoolToVis}}" />
                            <ListBox ItemsSource="{Binding LocalBranches}" ItemTemplate="{StaticResource BranchTemplate}"
                                     Style="{StaticResource RowListStyle}"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     Visibility="{Binding HasLocalBranches, Converter={StaticResource BoolToVis}}">
                                <ListBox.ContextMenu>
                                    <ContextMenu Style="{StaticResource OwnerContextMenuStyle}">
                                        <MenuItem Header="{Binding CopyNameText}" Click="OnCopyRefName" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                            </ListBox>

                            <TextBlock Text="{Binding RemoteBranchesHeader}" Style="{StaticResource SectionHeaderStyle}"
                                       Visibility="{Binding HasRemoteBranches, Converter={StaticResource BoolToVis}}" />
                            <ListBox ItemsSource="{Binding RemoteBranches}"
                                     ItemTemplate="{StaticResource BranchTemplate}"
                                     Style="{StaticResource RowListStyle}"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     Visibility="{Binding HasRemoteBranches, Converter={StaticResource BoolToVis}}">
                                <ListBox.ContextMenu>
                                    <ContextMenu Style="{StaticResource OwnerContextMenuStyle}">
                                        <MenuItem Header="{Binding CopyNameText}" Click="OnCopyRefName" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock Text="{Binding EmptyBranchesText}" Style="{StaticResource EmptyTextStyle}"
                               Visibility="{Binding HasAnyBranch, Converter={StaticResource BoolToVis},
                                            ConverterParameter=invert}" />
                </Grid>
            </TabItem>

            <TabItem Header="{Binding TagsHeader}">
                <Grid>
                    <ListBox ItemsSource="{Binding Tags}" ItemTemplate="{StaticResource TagTemplate}"
                             Style="{StaticResource RowListStyle}"
                             Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}">
                        <ListBox.ContextMenu>
                            <ContextMenu Style="{StaticResource OwnerContextMenuStyle}">
                                <MenuItem Header="{Binding CopyNameText}" Click="OnCopyRefName" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                    <TextBlock Text="{Binding EmptyTagsText}" Style="{StaticResource EmptyTextStyle}"
                               Visibility="{Binding HasTags, Converter={StaticResource BoolToVis},
                                            ConverterParameter=invert}" />
                </Grid>
            </TabItem>

            <TabItem Header="{Binding RemotesHeader}">
                <Grid>
                    <ListBox ItemsSource="{Binding Remotes}" ItemTemplate="{StaticResource RemoteTemplate}"
                             Style="{StaticResource RowListStyle}"
                             Visibility="{Binding HasRemotes, Converter={StaticResource BoolToVis}}">
                        <ListBox.ContextMenu>
                            <ContextMenu Style="{StaticResource OwnerContextMenuStyle}">
                                <MenuItem Header="{Binding CopyUrlText}" Click="OnCopyRemoteUrl" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                    <TextBlock Text="{Binding EmptyRemotesText}" Style="{StaticResource EmptyTextStyle}"
                               Visibility="{Binding HasRemotes, Converter={StaticResource BoolToVis},
                                            ConverterParameter=invert}" />
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 复制反馈：浮在内容上方，不挤压布局，几秒后自动消失。 -->
        <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="0,0,0,18" Padding="14,7" CornerRadius="4"
                Background="{DynamicResource ChipBackground}"
                BorderBrush="{DynamicResource ChipBorder}" BorderThickness="1"
                IsHitTestVisible="False"
                Visibility="{Binding HasToast, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ToastText}" Foreground="{DynamicResource ChipText}" FontSize="12" />
        </Border>
    </Grid>
</UserControl>
