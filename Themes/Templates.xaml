<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 各个页签的行模板。

         必须自己合并 Controls.xaml：StaticResource 只在本字典及其 MergedDictionaries
         里查找，不会去看"和自己并列被合并进同一个宿主"的兄弟字典。下面用到的
         HashTextStyle / RefChipBorderStyle / BoolToVis 全在那边。

         URI 写成带程序集名的完整形式，理由同 GitPanel.xaml.cs 里的 ApplyTheme：
         插件是 Assembly.LoadFrom 加载的，相对形式会去 QuickLook.exe 里找资源。 -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/QuickLook.Plugin.GitViewer;component/Themes/Controls.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- 单个改动文件。
         增删行数放在路径左边而不是行尾：行尾的话文件一多，数字和文件名之间隔着
         一大片空白，很容易看错行；放左边则始终紧邻状态字母，且各行天然对齐。 -->
    <DataTemplate x:Key="FileChangeTemplate">
        <Grid Margin="0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 只显示首字母；R095 那个相似度数字在 ToolTip 里。
                 颜色跟着 Kind 走，用触发器实现，不额外引入转换器。 -->
            <TextBlock Grid.Column="0" Text="{Binding StatusLetter}" FontFamily="{StaticResource MonoFont}"
                       FontSize="11" VerticalAlignment="Center" ToolTip="{Binding StatusTooltip}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource DiffNeutral}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="Added">
                                <Setter Property="Foreground" Value="{DynamicResource DiffAdded}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Deleted">
                                <Setter Property="Foreground" Value="{DynamicResource DiffDeleted}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Renamed">
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- 为 0 时压暗，让眼睛直接跳过。 -->
            <TextBlock Grid.Column="1" FontSize="11" FontFamily="{StaticResource MonoFont}"
                       VerticalAlignment="Center" Margin="0,0,6,0" TextAlignment="Right"
                       Text="{Binding Added, StringFormat=+{0}}"
                       Visibility="{Binding IsBinary, Converter={StaticResource BoolToVis},
                                    ConverterParameter=invert}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource DiffAdded}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Added}" Value="0">
                                <Setter Property="Foreground" Value="{DynamicResource DiffNeutral}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Grid.Column="2" FontSize="11" FontFamily="{StaticResource MonoFont}"
                       VerticalAlignment="Center" Margin="0,0,10,0" TextAlignment="Right"
                       Text="{Binding Deleted, StringFormat=-{0}}"
                       Visibility="{Binding IsBinary, Converter={StaticResource BoolToVis},
                                    ConverterParameter=invert}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource DiffDeleted}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Deleted}" Value="0">
                                <Setter Property="Foreground" Value="{DynamicResource DiffNeutral}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Text="bin" FontSize="11"
                       FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource MutedText}"
                       VerticalAlignment="Center" Margin="0,0,10,0" TextAlignment="Right"
                       Visibility="{Binding IsBinary, Converter={StaticResource BoolToVis}}" />

            <!-- 用嵌套 Grid 而不是横向 StackPanel：StackPanel 给子元素无限宽度，
                 长路径的省略号就不会生效。 -->
            <Grid Grid.Column="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 间距用 Margin 而不是格式串里的尾随空格：标记扩展会把尾随空格裁掉。 -->
                <TextBlock Grid.Column="0" Text="{Binding OldPath, StringFormat={}{0} →}"
                           Foreground="{DynamicResource MutedText}" FontSize="11" Margin="0,0,5,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="220"
                           Visibility="{Binding HasOldPath, Converter={StaticResource BoolToVis}}" />

                <TextBlock Grid.Column="1" Text="{Binding Path}" Foreground="{DynamicResource SecondaryText}"
                           FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Path}" />
            </Grid>
        </Grid>
    </DataTemplate>

    <!-- 提交行：摘要一行，展开后在下面接一块详情。
         展开状态存在 CommitViewModel 上，不在容器上 —— 列表开了容器回收，
         状态存容器会导致滚动后展开的是别的行。 -->
    <DataTemplate x:Key="CommitTemplate">
        <StackPanel>
            <!-- 摘要行。Background 必须给 Transparent，否则空白处不参与命中测试，
                 点在两列之间的空隙上不会展开。名字被 GitPanel.xaml.cs 用来判断
                 点击是不是来自详情区，改名要同步那边。 -->
            <Grid x:Name="CommitSummary" Margin="10,5,6,5" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 纯指示符，不是按钮：整行都可以点。 -->
                <TextBlock Grid.Column="0" Text="&#x25B8;" FontSize="10" Margin="0,0,6,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource MutedText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                    <Setter Property="Text" Value="&#x25BE;" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Grid.Column="1" Text="{Binding ShortHash}" Style="{StaticResource HashTextStyle}"
                           Margin="0,0,10,0" ToolTip="{Binding Hash}" />

                <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Subject}" Foreground="{DynamicResource PrimaryText}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Subject}" />
                    <ItemsControl ItemsSource="{Binding DecorationList}" Margin="0,2,0,0"
                                  Visibility="{Binding HasDecorations, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RefChipBorderStyle}">
                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource RefChipText}"
                                               FontSize="11" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Grid.Column="3" Text="{Binding AuthorName}" Foreground="{DynamicResource SecondaryText}"
                           Margin="12,0,12,0" VerticalAlignment="Center" MaxWidth="140"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding AuthorTooltip}" />

                <TextBlock Grid.Column="4" Text="{Binding RelativeTime}" Foreground="{DynamicResource MutedText}"
                           VerticalAlignment="Center" MinWidth="88" TextAlignment="Right"
                           ToolTip="{Binding AbsoluteTime}" />
            </Grid>

            <!-- 详情区。名字被 GitPanel.xaml.cs 用来判断点击来源：点这里面不该收起整行。 -->
            <StackPanel x:Name="CommitDetail" Margin="34,0,6,10"
                        Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Body}" Foreground="{DynamicResource SecondaryText}"
                           FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                           Visibility="{Binding HasBody, Converter={StaticResource BoolToVis}}" />

                <TextBlock Text="{Binding LoadingLabel}" Foreground="{DynamicResource MutedText}" FontSize="11"
                           Visibility="{Binding IsLoadingFiles, Converter={StaticResource BoolToVis}}" />

                <TextBlock Text="{Binding MergeLabel}" Foreground="{DynamicResource MutedText}" FontSize="11"
                           TextWrapping="Wrap"
                           Visibility="{Binding IsMerge, Converter={StaticResource BoolToVis}}" />

                <TextBlock Text="{Binding NoChangesLabel}" Foreground="{DynamicResource MutedText}" FontSize="11"
                           Visibility="{Binding HasNoChanges, Converter={StaticResource BoolToVis}}" />

                <TextBlock Text="{Binding LoadFailedLabel}" Foreground="{DynamicResource ErrorText}" FontSize="11"
                           TextWrapping="Wrap"
                           Visibility="{Binding LoadFailed, Converter={StaticResource BoolToVis}}" />

                <ItemsControl ItemsSource="{Binding Files}" ItemTemplate="{StaticResource FileChangeTemplate}"
                              Visibility="{Binding HasFiles, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- 分支行：名称、跟踪状态、最新提交哈希、说明、相对时间。 -->
    <DataTemplate x:Key="BranchTemplate">
        <Grid Margin="10,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x25CF;" Foreground="{DynamicResource Accent}" Margin="0,0,5,0"
                               VerticalAlignment="Center" FontSize="10"
                               Visibility="{Binding IsHead, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource PrimaryText}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Track}" Foreground="{DynamicResource Accent}" FontSize="11"
                               Margin="8,0,0,0" VerticalAlignment="Center"
                               Visibility="{Binding HasTrack, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <TextBlock Text="{Binding Subject}" Foreground="{DynamicResource MutedText}" FontSize="11"
                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subject}" />
            </StackPanel>

            <TextBlock Grid.Column="1" Text="{Binding ObjectName}" Style="{StaticResource HashTextStyle}"
                       Margin="12,0,12,0" FontSize="11" />

            <TextBlock Grid.Column="2" Text="{Binding RelativeTime}" Foreground="{DynamicResource MutedText}"
                       VerticalAlignment="Center" MinWidth="88" TextAlignment="Right"
                       ToolTip="{Binding AbsoluteTime}" />
        </Grid>
    </DataTemplate>

    <!-- 标签行：名称、所指对象哈希、说明、相对时间。 -->
    <DataTemplate x:Key="TagTemplate">
        <Grid Margin="10,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource PrimaryText}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subject}" Foreground="{DynamicResource MutedText}" FontSize="11"
                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subject}" />
            </StackPanel>

            <TextBlock Grid.Column="1" Text="{Binding ObjectName}" Style="{StaticResource HashTextStyle}"
                       Margin="12,0,12,0" FontSize="11" />

            <TextBlock Grid.Column="2" Text="{Binding RelativeTime}" Foreground="{DynamicResource MutedText}"
                       VerticalAlignment="Center" MinWidth="88" TextAlignment="Right"
                       ToolTip="{Binding AbsoluteTime}" />
        </Grid>
    </DataTemplate>

    <!-- 远程行：名称与 URL。 -->
    <DataTemplate x:Key="RemoteTemplate">
        <StackPanel Margin="10,6">
            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource PrimaryText}" />
            <TextBlock Text="{Binding Url}" Foreground="{DynamicResource SecondaryText}" FontSize="11"
                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Url}" />
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
