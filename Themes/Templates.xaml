<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 各个页签的行模板。

         必须自己合并 Controls.xaml：StaticResource 只在本字典及其 MergedDictionaries
         里查找，不会去看"和自己并列被合并进同一个宿主"的兄弟字典。下面用到的
         HashTextStyle / RefChipBorderStyle / BoolToVis 全在那边。

         URI 写成带程序集名的完整形式，理由同 GitPanel.xaml.cs 里的 ApplyTheme：
         插件是 Assembly.LoadFrom 加载的，相对形式会去 QuickLook.exe 里找资源。 -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/QuickLook.Plugin.GitViewer;component/Themes/Controls.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- 提交行：哈希、提交说明及 ref 小标签、作者、相对时间。 -->
    <DataTemplate x:Key="CommitTemplate">
        <Grid Margin="10,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding ShortHash}" Style="{StaticResource HashTextStyle}"
                       Margin="0,0,10,0" ToolTip="{Binding Hash}" />

            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                <TextBlock Text="{Binding Subject}" Foreground="{DynamicResource PrimaryText}"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Subject}" />
                <ItemsControl ItemsSource="{Binding DecorationList}" Margin="0,2,0,0"
                              Visibility="{Binding HasDecorations, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource RefChipBorderStyle}">
                                <TextBlock Text="{Binding}" Foreground="{DynamicResource RefChipText}"
                                           FontSize="11" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock Grid.Column="2" Text="{Binding AuthorName}" Foreground="{DynamicResource SecondaryText}"
                       Margin="12,0,12,0" VerticalAlignment="Center" MaxWidth="140"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding AuthorTooltip}" />

            <TextBlock Grid.Column="3" Text="{Binding RelativeTime}" Foreground="{DynamicResource MutedText}"
                       VerticalAlignment="Center" MinWidth="88" TextAlignment="Right"
                       ToolTip="{Binding AbsoluteTime}" />
        </Grid>
    </DataTemplate>

    <!-- 分支行：名称、跟踪状态、最新提交哈希、说明、相对时间。 -->
    <DataTemplate x:Key="BranchTemplate">
        <Grid Margin="10,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x25CF;" Foreground="{DynamicResource Accent}" Margin="0,0,5,0"
                               VerticalAlignment="Center" FontSize="10"
                               Visibility="{Binding IsHead, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource PrimaryText}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Track}" Foreground="{DynamicResource Accent}" FontSize="11"
                               Margin="8,0,0,0" VerticalAlignment="Center"
                               Visibility="{Binding HasTrack, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <TextBlock Text="{Binding Subject}" Foreground="{DynamicResource MutedText}" FontSize="11"
                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subject}" />
            </StackPanel>

            <TextBlock Grid.Column="1" Text="{Binding ObjectName}" Style="{StaticResource HashTextStyle}"
                       Margin="12,0,12,0" FontSize="11" />

            <TextBlock Grid.Column="2" Text="{Binding RelativeTime}" Foreground="{DynamicResource MutedText}"
                       VerticalAlignment="Center" MinWidth="88" TextAlignment="Right"
                       ToolTip="{Binding AbsoluteTime}" />
        </Grid>
    </DataTemplate>

    <!-- 标签行：名称、所指对象哈希、说明、相对时间。 -->
    <DataTemplate x:Key="TagTemplate">
        <Grid Margin="10,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource PrimaryText}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subject}" Foreground="{DynamicResource MutedText}" FontSize="11"
                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subject}" />
            </StackPanel>

            <TextBlock Grid.Column="1" Text="{Binding ObjectName}" Style="{StaticResource HashTextStyle}"
                       Margin="12,0,12,0" FontSize="11" />

            <TextBlock Grid.Column="2" Text="{Binding RelativeTime}" Foreground="{DynamicResource MutedText}"
                       VerticalAlignment="Center" MinWidth="88" TextAlignment="Right"
                       ToolTip="{Binding AbsoluteTime}" />
        </Grid>
    </DataTemplate>

    <!-- 远程行：名称与 URL。 -->
    <DataTemplate x:Key="RemoteTemplate">
        <StackPanel Margin="10,6">
            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource PrimaryText}" />
            <TextBlock Text="{Binding Url}" Foreground="{DynamicResource SecondaryText}" FontSize="11"
                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Url}" />
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
