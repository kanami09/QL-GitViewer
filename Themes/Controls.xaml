<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:QuickLook.Plugin.GitViewer.Helpers">

    <!-- 控件样式。只放与配色无关的形状与模板，颜色一律通过 DynamicResource
         引用 Dark.xaml / Light.xaml 里的画刷 —— 那两个字典是运行时才合并进来的，
         写成 StaticResource 会在加载本字典时就解析失败。

         本字典内部的互相引用（如 RowListStyle 引用 RowItemStyle）走 StaticResource，
         被引用者必须写在引用者前面，调整顺序前请留意。 -->

    <helpers:BoolToVisibilityConverter x:Key="BoolToVis" />

    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New, monospace</FontFamily>

    <Style x:Key="ChipBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ChipBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ChipBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="Margin" Value="0,0,6,4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ChipTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ChipText}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style x:Key="RefChipBorderStyle" TargetType="Border" BasedOn="{StaticResource ChipBorderStyle}">
        <Setter Property="Background" Value="{DynamicResource RefChipBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource RefChipBorder}" />
        <Setter Property="Margin" Value="0,1,4,1" />
        <Setter Property="Padding" Value="5,0" />
    </Style>

    <Style x:Key="HashTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="Foreground" Value="{DynamicResource HashText}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="10,10,10,4" />
    </Style>

    <Style x:Key="EmptyTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
        <Setter Property="Margin" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 行容器：去掉焦点虚线框，悬停与选中颜色跟随主题。
         右键选中行的逻辑不在这里：EventSetter 的 Handler 要求字典带 x:Class code-behind，
         那样这个纯样式字典就得挂一个代码文件。改由 GitPanel.xaml 在每个 ListBox 上
         挂 PreviewMouseRightButtonDown。 -->
    <Style x:Key="RowItemStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowSelected}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RowListStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource RowItemStyle}" />
        <!-- 这个属性默认是 null，含义为"ItemsSource 本身是 ICollectionView 时按 true 处理"。
             分支页绑的正是 ListCollectionView，于是列表会去跟它的 CurrentItem 同步，
             一切换过去第一行就自动选中了。其余三页绑的是普通 IList，不受影响。
             我们没有任何地方用到 CurrentItem，直接关掉。 -->
        <Setter Property="IsSynchronizedWithCurrentItem" Value="False" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling" />
    </Style>

    <!-- TabControl 自带的外观写死了浅灰色，不换掉的话深色主题下会很突兀。 -->
    <Style x:Key="FlatTabItemStyle" TargetType="TabItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" Background="Transparent" BorderThickness="0,0,0,2"
                            BorderBrush="Transparent" Padding="14,7">
                        <ContentPresenter x:Name="Header" ContentSource="Header"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextBlock.Foreground="{DynamicResource SecondaryText}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Header" Property="TextBlock.Foreground"
                                    Value="{DynamicResource PrimaryText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FlatTabControlStyle" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource FlatTabItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" BorderBrush="{DynamicResource Separator}" BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True" Margin="8,0,0,0" />
                        </Border>
                        <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 菜单项。必须跟 ContextMenu 一起换掉：MenuItem 自带的前景色是黑色，
         只把菜单背景改深会变成黑底黑字。
         高亮用 IsHighlighted 而不是 IsMouseOver，这样键盘上下键导航也有反馈。 -->
    <Style x:Key="FlatMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            TextElement.Foreground="{TemplateBinding Foreground}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource MenuItemHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="TextElement.Foreground"
                                    Value="{DynamicResource MutedText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ContextMenu 不在可视树里，不会继承 DataContext，
         必须手动指向它所属元素的 DataContext。
         同时要整个换掉默认模板：默认模板里有一条 28px 宽的图标栏
         (#FFF1F1F1) 和两条 1px 竖线 (#FFE2E3E3 / #FFFFFFFF)，颜色全是写死的字面量，
         不走 DynamicResource，所以无论什么主题都是浅色的。我们的菜单项没有图标，
         那条图标栏只是一条白色空带，直接去掉。 -->
    <Style x:Key="OwnerContextMenuStyle" TargetType="ContextMenu">
        <Setter Property="DataContext"
                Value="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Background" Value="{DynamicResource MenuBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MenuBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0,4" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource FlatMenuItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="4" SnapsToDevicePixels="True">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
