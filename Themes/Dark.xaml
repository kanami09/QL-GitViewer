<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 深色配色。必须定义与 Light.xaml 完全相同的键。 -->

    <SolidColorBrush x:Key="PanelBackground" Color="#FF202020" />
    <SolidColorBrush x:Key="HeaderBackground" Color="#FF2A2A2A" />

    <SolidColorBrush x:Key="PrimaryText" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="SecondaryText" Color="#FFB4B4B4" />
    <SolidColorBrush x:Key="MutedText" Color="#FF8A8A8A" />
    <SolidColorBrush x:Key="ErrorText" Color="#FFFF99A4" />

    <SolidColorBrush x:Key="Separator" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="Accent" Color="#FF60CDFF" />

    <SolidColorBrush x:Key="HashText" Color="#FFD2A8FF" />

    <SolidColorBrush x:Key="ChipBackground" Color="#FF243440" />
    <SolidColorBrush x:Key="ChipBorder" Color="#FF37556B" />
    <SolidColorBrush x:Key="ChipText" Color="#FF60CDFF" />

    <SolidColorBrush x:Key="RefChipBackground" Color="#FF23331F" />
    <SolidColorBrush x:Key="RefChipBorder" Color="#FF3C5A34" />
    <SolidColorBrush x:Key="RefChipText" Color="#FF7EE787" />

    <SolidColorBrush x:Key="MenuBackground" Color="#FF2D2D2D" />
    <SolidColorBrush x:Key="MenuBorder" Color="#FF454545" />
    <SolidColorBrush x:Key="MenuItemHover" Color="#FF3F4A55" />

    <SolidColorBrush x:Key="RowHover" Color="#FF2C2C2C" />
    <SolidColorBrush x:Key="RowSelected" Color="#FF33414D" />

</ResourceDictionary>
