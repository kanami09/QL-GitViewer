<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 浅色配色。Dark.xaml 重定义的就是这一批键，
         在这里新增画刷时必须同步加到那边，否则深色主题下会取不到值。 -->

    <SolidColorBrush x:Key="PanelBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="HeaderBackground" Color="#FFF6F6F6" />

    <SolidColorBrush x:Key="PrimaryText" Color="#FF1B1B1B" />
    <SolidColorBrush x:Key="SecondaryText" Color="#FF5A5A5A" />
    <SolidColorBrush x:Key="MutedText" Color="#FF8A8A8A" />
    <SolidColorBrush x:Key="ErrorText" Color="#FFC42B1C" />

    <SolidColorBrush x:Key="Separator" Color="#FFE1E1E1" />
    <SolidColorBrush x:Key="Accent" Color="#FF0F6CBD" />

    <SolidColorBrush x:Key="HashText" Color="#FF8250DF" />

    <SolidColorBrush x:Key="ChipBackground" Color="#FFEDF3FA" />
    <SolidColorBrush x:Key="ChipBorder" Color="#FFC6D9EC" />
    <SolidColorBrush x:Key="ChipText" Color="#FF0F6CBD" />

    <SolidColorBrush x:Key="RefChipBackground" Color="#FFEFF6EF" />
    <SolidColorBrush x:Key="RefChipBorder" Color="#FFCBE3CB" />
    <SolidColorBrush x:Key="RefChipText" Color="#FF2A6B2A" />

    <SolidColorBrush x:Key="MenuBackground" Color="#FFFBFBFB" />
    <SolidColorBrush x:Key="MenuBorder" Color="#FFD2D2D2" />
    <SolidColorBrush x:Key="MenuItemHover" Color="#FFE8F1FB" />

    <SolidColorBrush x:Key="RowHover" Color="#FFF2F6FA" />
    <SolidColorBrush x:Key="RowSelected" Color="#FFE3EEF8" />

    <!-- 提交展开后的改动统计。两个主题必须都定义。 -->
    <SolidColorBrush x:Key="DiffAdded" Color="#FF1A7F37" />
    <SolidColorBrush x:Key="DiffDeleted" Color="#FFCF222E" />
    <SolidColorBrush x:Key="DiffNeutral" Color="#FF6E6E6E" />

</ResourceDictionary>
